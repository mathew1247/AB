# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of allowed origins (browser frontend), e.g. http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string. When set, interview state is persisted in
# MongoDB. When EMPTY/missing, the backend falls back to an in-memory store
# (great for local development and tests - data is lost on restart).
MONGODB_URI=

# ---- AI Provider ----
# mock: built-in deterministic provider (no API key needed). Use for demos/tests.
# openai: any OpenAI-compatible chat completions API (OpenAI, Groq, OpenRouter, Ollama, LM Studio...)
AI_PROVIDER=mock

# Only required when AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000

# ---- Interview defaults ----
DEFAULT_TOTAL_QUESTIONS=5
MAX_ANSWER_LENGTH=4000

# ---- Security ----
# Max requests per minute per IP against the /api routes
RATE_LIMIT_MAX=100
