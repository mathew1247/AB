{
  "version": 2,
  "builds": [
    {
      "src": "BACKEND/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "FRONTEND/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/BACKEND/api/index.js"
    },
    {
      "src": "/",
      "dest": "/FRONTEND/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/FRONTEND/$1"
    }
  ]
}
